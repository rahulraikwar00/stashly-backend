# Copy to .env and fill in. The .env file is gitignored — treat it like a password.

# Serving port — read by `python -m app` (the default is 8000 when unset).
PORT=3000

# Instagram credentials for the OFFICIAL account (the account your users DM
# with `/link <code>`). The session is cached to app/session.json on first login.
IG_USERNAME=your_official_account
IG_PASSWORD=your_password

# Optional: allow the apiKey-free flow for local dev only. Leave unset in prod.
# DEBUG_INSECURE_OPEN_API=true