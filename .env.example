# Copy to .env and fill in. The .env file is gitignored — treat it like a password.
#
# On Render set these as environment variables instead; never bake secrets into
# the Dockerfile or commit them.

# ── Serving ────────────────────────────────────────────────────────
# Read by `python -m app` (default 8000). Render injects PORT=10000 itself —
# do not set it there.
PORT=3000

# ── Postgres (required on Render) ──────────────────────────────────
# When set, the JSON files below are replaced by Postgres and /messages/links
# is served from the buffered mailbox. Use the POOLED connection string — the
# hostname must contain `-pooler`. `channel_binding=require` is stripped
# automatically (set DROP_CHANNEL_BINDING=false to keep it).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require

# Neon suspends compute after 5 idle minutes. Use a `test` branch for the suite:
#   TEST_DATABASE_URL=postgresql://...-pooler.../dbname?sslmode=require
# TEST_DATABASE_URL=

# ── Instagram credentials for the OFFICIAL account ─────────────────
# The account your users DM with `/link <code>`. Use a dedicated account with 2FA
# and no personal content: its session cookie is full control of every user's DM.
IG_USERNAME=your_official_account
IG_PASSWORD=your_password

# ── Session encryption (required on Render) ───────────────────────
# Generate with: `openssl rand -hex 32`
# Encrypts the Instagram session at rest. Without it the session is kept in
# memory only, which on Render means a fresh login from a new IP on every
# deploy — the pattern most likely to get the account checkpointed or banned.
IG_SESSION_KEY=

# ── Ingest / mailbox tuning ────────────────────────────────────────
# How long a message must sit before it is buffered. Defaults to
# CAPTION_WINDOW_SECONDS because a caption sent seconds after a share must be
# able to attach to it. Lower this and you lose captions (and their hashtags);
# setting 0 disables settling entirely.
# INGEST_SETTLE_SECONDS=
# CAPTION_WINDOW_SECONDS=120
# LINK_SCAN_SECONDS=20
# MAILBOX_CAP_PER_THREAD=500
# MAILBOX_DRAIN_LIMIT=200
# METADATA_CACHE_DAYS=7

# ── Auth throttling ────────────────────────────────────────────────
# A linked 6-digit code locks after this many failed attempts.
# AUTH_MAX_FAILURES=5
# AUTH_LOCK_SECONDS=900

# ── CORS ───────────────────────────────────────────────────────────
# The Expo client sends no browser Origin, so CORS is disabled by default.
# Comma-separated origins to opt back in for a web client.
# CORS_ORIGINS=https://your-web-client.example

# ── No apiKey-free dev mode ────────────────────────────────────────
# There is no DEBUG_INSECURE_OPEN_API switch — earlier docs mentioned one and
# no code has ever read it. Every /auth and /messages call needs
# `X-API-Key: <the 6-digit igCode>`, except the open /health, /auth/codes and
# /auth/config (which tells the app which account to DM). See README.md for the
# register -> DM /link <code> -> poll flow.

# ── Which official account users DM /link <code> to ─────────────────
# Served to the client from POST /auth/codes and GET /auth/config, so this is
# the ONLY place the handle is defined. The app used to hardcode it, which
# silently drifted once. Both endpoints also return `instagramConfigured`
# (username AND password set) so a half-configured server is distinguishable
# from a working one.
# IG_USERNAME=your_official_account